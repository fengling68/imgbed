# ============================================================
# 通用 .gitignore
# 适用：imgbed / MyAll / MyAllTools / MyBlogs / webdav-notes-app
# 覆盖：依赖、构建产物、缓存、日志、环境变量/密钥、OS 与编辑器文件、
#       本地 AI 工具目录、Android / Capacitor 产物、源码映射等
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/install-state.gz
.pnp/
.pnp.js
.npm

# ---------- 构建 / 产物 ----------
dist/
dist-ssr/
build/
out/
.release/
# 前端框架
.next/
.nuxt/
.output/
.svelte-kit/
.vercel/
.expo/
.vuepress/dist/
.docusaurus/
# Android / Capacitor / Cordova
android/.gradle/
.gradle/
android/app/build/
android/build/
.capacitor/
# 缓存
.cache/
.temp/
.tmp/
tmp/
.tempCache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.turbo/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---------- 测试 / 覆盖率 ----------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 环境变量 / 密钥 / 本地配置 ----------
.env
.env.*
!.env.example
*.local
# Android 签名与密钥
local.properties
*.keystore
*.jks
*.p12
*.pfx
# 运行时数据：数据库 / 锁 / 用户上传 / 实例锁 / JWT 密钥
*.sqlite
*.sqlite-jshm
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite.bak*
*.db
*.db-journal
*.jwt_secret
*.instance.lock

# ---------- 操作系统文件 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- 编辑器 / IDE ----------
.idea/
*.swp
*.swo
*.swn
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.project
.classpath
.settings/

# ---------- 本地 AI 工具目录（含工作记忆，勿提交）----------
.workbuddy/
.trae/
.cursor/

# ---------- 发布 / 二进制产物 ----------
release/
*.apk
*.aab
*.ipa
*.dmg
*.exe

# ---------- 源码映射（构建生成，无需入库）----------
*.map

# ---------- 项目特定生成物 ----------
# MyAllTools：构建时自动生成的 HTML 工具索引
public/htmlTool-manifest.json
# MyAllTools：vite 加载 TS 配置时生成的临时文件
vite.config.ts.timestamp-*.mjs
